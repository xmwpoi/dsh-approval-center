# T3 扩展（见 docs/evidence/task-notifications/integration.md §2）：
# 不再使用 omit=peer。派发书要求"不要 --omit=peer 导致完整 CLI 缺包"——实测
# @deepseek-ai/dsh-subagent/lib/index.js 在模块加载期就 import
# @deepseek-ai/dsh-tools、@deepseek-ai/dsh-attachment、@deepseek-ai/dsh-util-time，
# 而 dsh-tools 又 import @deepseek-ai/dsh-sandbox；这些包只是 peerDependencies，
# omit=peer 会让 import('@deepseek-ai/dsh-subagent') 直接 ERR_MODULE_NOT_FOUND。
# 因此本 fixture 保留 npm 默认的 peer 自动安装，依赖树由 package-lock.json 固定。
audit=false
fund=false
