{
  "name": "dsh-approval-center",
  "version": "0.3.0",
  "description": "DSH (DeepSeek Harness) plugin: Windows notification-center approvals (approve/reject buttons) and completion notifications for parallel subagents — a task control center for human-in-the-loop approvals.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "windows",
    "subagent"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "win32"
  ],
  "license": "MIT",
  "author": "xmwpoi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmwpoi/dsh-approval-center.git"
  },
  "bugs": {
    "url": "https://github.com/xmwpoi/dsh-approval-center/issues"
  },
  "homepage": "https://github.com/xmwpoi/dsh-approval-center#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.0"
  },
  "dependencies": {
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-concurrency=1 test/host-contract.test.js test/queue.test.js test/store.test.js test/dialog.test.js test/dialog.scripts.test.js test/dialog.cleanup.test.js test/dialog.uri-handler.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/",
    "test:approval": "node test/approval.test.js",
    "test": "npm run typecheck && npm run test:unit && npm run test:integration"
  }
}
